<?xml version="1.0" ?>
<!DOCTYPE ACAT [
  <!ENTITY functionButtonFontName "ACAT FONT 1">
  <!ENTITY functionButtonAltFontName "Montserrat Regular">
  <!ENTITY functionButtonFontSize "28">
]>

<ACAT>
  <WidgetAttributes>
        <WidgetAttribute name="Settings" value="@CmdGoBack" fontname="&functionButtonFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="Help" value="@CmdTypingModeSentence" fontname="&functionButtonFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="About" value="@CmdTypingModePhrase" fontname="&functionButtonAltFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="Home" value="@CmdTypingModeShortHand" fontname="&functionButtonFontName;" fontsize="&functionButtonFontSize;" bold="false" />
  </WidgetAttributes>

  <Layout>
	  <Widget class="BoxWidget"  name="ToolbarTableLayoutPanel">
      <Widget class="RowWidget" name ="ButtonPanel" >
		    <Widget class="ScannerButton" name="Settings" colorScheme="ScannerButton" />
		    <Widget class="ScannerButton" name="Help" colorScheme="ScannerButton" />
		    <Widget class="ScannerButton" name="About" colorScheme="ScannerButton" />
		    <Widget class="ScannerButton" name="Home" colorScheme="ScannerButton" />
  	  </Widget>
    </Widget>
  </Layout>

  <Animations>
    <Animation name="ToolbarListRotation"
                   iterations="@WordPredictionScanIterations"
                   firstPauseTime="@WordPredictionFirstPauseTime"
                   onSelect="actuate(@SelectedWidget); transition(ToolbarListRotation)"
                   onEnd="transition(ToolbarListRotation)">
      <Widget name="Settings" />
      <Widget name="Help" />
      <Widget name="About" />
      <Widget name="Home" />
    </Animation>
  </Animations>
</ACAT>