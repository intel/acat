<?xml version="1.0" ?>
<!DOCTYPE ACAT [
]>

<ACAT>
  <WidgetAttributes>
    <WidgetAttribute name="Menu" value="@CmdMainMenu" />
  </WidgetAttributes>

  <Layout>
    <Widget class="BoxWidget"  name="ToolbarBox">
      <Widget class="RowWidget" name ="DefaultButtonsBox">
        <Widget class="ScannerButton" name="Menu" colorScheme="ScannerButton" />
      </Widget>
    </Widget>
  </Layout>

  <Animations>
    <Animation name="TopLevelRotation"
            start="true"
            onEnter=""
            scanTime="@MenuDialogScanTime"
            iterations="1"
            onSelect="stop();actuate(@SelectedWidget);start();"
            autoStart="true">
      <Widget name="Menu" />
    </Animation>
  </Animations>
</ACAT>