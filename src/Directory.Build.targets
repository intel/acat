<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(OutputType)' == 'Library'">
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <ReferenceAssemblyPath>
      $(OutputPath)$(AssemblyName).ref.dll
    </ReferenceAssemblyPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OutputType)' == 'Exe'">
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <PropertyGroup>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm">
      <Version>8.4.0</Version>
    </PackageReference>
  </ItemGroup>

    <!-- Prevent non-Windows native files from being copied to output -->
    <Target Name="FilterBrainFlowNativeFiles" BeforeTargets="ResolveAssemblyReferences">
      <ItemGroup>
        <!-- Exclude Unix/Linux native libraries -->
        <None Remove="**\*.dylib" />
        <None Remove="**\*.so" />
        <Content Remove="**\*.dylib" />
        <Content Remove="**\*.so" />

        <!-- Exclude 32-bit and x86 binaries on x64 builds -->
        <None Remove="**\*32.dll" />
        <None Remove="**\*x86.dll" />
        <None Remove="**\x86\*.*" />
        <None Remove="**\Win32\*.*" />
        <Content Remove="**\*32.dll" />
        <Content Remove="**\*x86.dll" />
        <Content Remove="**\x86\*.*" />
        <Content Remove="**\Win32\*.*" />
      </ItemGroup>
    </Target>

    <!-- Filter NuGet runtime assets to only include win-x64 -->
    <Target Name="FilterNuGetRuntimeAssets" BeforeTargets="ResolvePackageAssets">
      <ItemGroup>
        <!-- Remove non-Windows runtime assets from packages -->
        <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.Identity)').Contains('linux-'))" />
        <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.Identity)').Contains('osx-'))" />
        <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.Identity)').Contains('unix-'))" />
        <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.Identity)').Contains('win-x86'))" />
        <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.Identity)').Contains('win-arm'))" />

        <!-- Also filter by file extension -->
        <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.Identity)').EndsWith('.dylib'))" />
        <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.Identity)').EndsWith('.so'))" />
      </ItemGroup>
    </Target>

    <!-- Fallback: Remove non-Windows files from output if they were copied -->
    <Target Name="CleanupNonWindowsFiles" AfterTargets="Build">
      <ItemGroup>
        <FilesToDelete Include="$(OutputPath)**\*.dylib" />
        <FilesToDelete Include="$(OutputPath)**\*.so" />
        <FilesToDelete Include="$(OutputPath)**\*32.dll" />
        <FilesToDelete Include="$(OutputPath)**\*x86.dll" />
      </ItemGroup>
      <!-- Use ContinueOnError to handle locked files gracefully -->
      <Delete Files="@(FilesToDelete)" ContinueOnError="true">
        <Output TaskParameter="DeletedFiles" ItemName="SuccessfullyDeleted"/>
      </Delete>
      <Message Text="Cleaned up @(SuccessfullyDeleted->Count()) non-Windows native files" Importance="low" Condition="'@(SuccessfullyDeleted)' != ''" />
    </Target>


  <PropertyGroup>
    <SignToolPath>C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe</SignToolPath>
  </PropertyGroup>

  <Target Name="SignBinaries" AfterTargets="Build" Condition="'$(Configuration)'=='Release_signed'">
    <Message Text="Signing $(TargetPath)" Importance="High" />
    <Exec
      Command='"$(SignToolPath)" sign /fd sha384 /sha1 619446055846541120570829B59910707A3B1951 /tr http://timestamp.intel.com/TSS/HttpTspServer /td SHA384 "$(TargetPath)"' />
  </Target>

  <Target Name="SignBinariesDebug" AfterTargets="Build" Condition="'$(Configuration)'=='Debug_signed'">
    <Message Text="Signing $(TargetPath)" Importance="High" />
    <Exec
      Command='"$(SignToolPath)" sign /fd sha256 /sha1 f4d92f3f1cc377a89792941ddb5c600b485d8f9f /tr http://timestamp.intel.com/TSS/HttpTspServer /td SHA256 "$(TargetPath)"' />
  </Target>

</Project>
