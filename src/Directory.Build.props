<Project>
  <!-- Diagnostic target should be direct child of Project -->
  <Target Name="PrintProps" BeforeTargets="BeforeBuild">
    <Message Text="--- Custom Build Props Diagnostic ---" Importance="High" />
    <Message Text="Configuration: $(Configuration)" Importance="High" />
    <Message Text="Platform: $(Platform)" Importance="High" />
    <Message Text="OutputPath: $(OutputPath)" Importance="High" />
    <Message Text="IntermediateOutputPath: $(IntermediateOutputPath)" Importance="High" />
    <Message Text="ExtensionPath: $(ExtensionPath)" Importance="High" />
  </Target>

  <!-- Base output and version info -->
  <PropertyGroup>
    <VersionPrefix>4.0.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix)</AssemblyVersion>
    <FileVersion>$(VersionPrefix)</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <NeutralLanguage>en</NeutralLanguage>
    <LangVersion>9.0</LangVersion>
    <Platforms>x64</Platforms>
    <TargetFramework>net481</TargetFramework>
  </PropertyGroup>

  <!-- Common Assembly Information -->
  <PropertyGroup>
    <Company>Intel Corporation</Company>
    <Product>Adaptive Contextual Aware Toolkit</Product>
    <Copyright>Copyright © Intel Corporation 2025</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <SolutionRoot>$(MSBuildThisFileDirectory)</SolutionRoot>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Base output paths -->
    <BaseOutputPath>$(SolutionRoot)build\</BaseOutputPath>
    <BuildPath>$(BaseOutputPath)bin\$(Configuration)\</BuildPath>
    <IntermediatePath>$(BaseOutputPath)obj\$(Configuration)\</IntermediatePath>

    <!-- Set output folders -->
    <OutputPath>$(BuildPath)</OutputPath>
    <BaseIntermediateOutputPath>$(IntermediatePath)$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(IntermediatePath)$(MSBuildProjectName)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Warnings and Errors -->
  <PropertyGroup>
    <!-- Show all nullable warnings -->
    <WarningsAsErrors>CS8600;CS8602;CS8603;CS8604;CS8618</WarningsAsErrors>

    <!-- Suppress NETSDK1022 - known issue with preview SDK 10.0.200 and EnableDefaultCompileItems=false -->
    <!-- This is a false positive for auto-generated assembly attributes in obj folder -->
    <!-- The file is not actually being compiled twice, just detected by the check -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);NETSDK1022</MSBuildWarningsAsMessages>

    <!-- Or to turn *all* warnings into errors -->
    <!-- <TreatWarningsAsErrors>true</TreatWarningsAsErrors> -->
  </PropertyGroup>
  
  <!-- Configurations -->
  <PropertyGroup>
    <Configurations>Debug;Release;Debug_TestGTEC;Debug_signed;Release_signed</Configurations>
    <UsePreviewSdk>false</UsePreviewSdk>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug_TestGTEC'">
    <DefineConstants>DEBUG;TRACE;SIMULATIONBOARD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug_signed' or '$(Configuration)' == 'Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release_signed' or '$(Configuration)' == 'Release'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Resources.Extensions" Version ="8.0.0" />
  </ItemGroup>

  <!-- Fix NETSDK1022: Exclude auto-generated files from obj and bin folders -->
  <!-- This prevents duplicate compilation of SDK-generated files -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**\*;bin\**\*</DefaultItemExcludes>

    <!-- Disable the duplicate items check entirely - it's a false positive with preview SDK -->
    <!-- The actual compilation doesn't have issues, just the detection mechanism -->
    <EnableDefaultCompileItemsCheck>false</EnableDefaultCompileItemsCheck>
  </PropertyGroup>

</Project>