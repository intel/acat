<?xml version="1.0" ?>
<!DOCTYPE ACAT [
  <!ENTITY functionButtonFontName "ACAT FONT 1">
  <!ENTITY functionButtonAltFontName "ACAT Icon">
  <!ENTITY functionButtonFontSize "44">

]>

<ACAT>
  <WidgetAttributes>
        <WidgetAttribute name="ACATTalk" value="@CmdGoBack" fontname="&functionButtonAltFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="QuickTalk" value="@CmdTypingModeSentence" fontname="&functionButtonAltFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="PointerControl" value="@CmdTypingModePhrase" fontname="&functionButtonAltFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="Keyboard" value="@CmdTypingModeShortHand" fontname="&functionButtonFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="System" value="@CmdTypingModeShortHand" fontname="&functionButtonFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="Location" value="@CmdTypingModeShortHand" fontname="&functionButtonFontName;" fontsize="&functionButtonFontSize;" bold="false" />
  </WidgetAttributes>

  <Layout>
    <Widget class="BoxWidget"  name="ToolbarTableLayoutPanel">
      <Widget class="RowWidget" name ="ButtonPanel" >
		    <Widget class="ScannerButton" name="ACATTalk" />
		    <Widget class="ScannerButton" name="QuickTalk" />
		    <Widget class="ScannerButton" name="PointerControl" />
		    <Widget class="ScannerButton" name="Keyboard" />
		    <Widget class="ScannerButton" name="System" />
		    <Widget class="ScannerButton" name="Location" />
      </Widget>
    </Widget>
  </Layout>

  <Animations>
    <Animation name="ToolbarListRotation"
                   iterations="@WordPredictionScanIterations"
                   firstPauseTime="@WordPredictionFirstPauseTime"
                   onSelect="actuate(@SelectedWidget); transition(ToolbarListRotation)"
                   onEnd="transition(TopLevelRotationToolbar)">
      <Widget name="ACATTalk" />
      <Widget name="QuickTalk" />
      <Widget name="PointerControl" />
      <Widget name="Keyboard" />
      <Widget name="System" />
      <Widget name="Location" />
    </Animation>
  </Animations>
 </ACAT>