        {
          "name": "Row2",
          "playBeep": false,
          "onSelected": "actuate(ItemText2);transition(TopLevelRotation)"
        },
        {
          "name": "Row3",
          "playBeep": false,
          "onSelected": "actuate(ItemText3);transition(TopLevelRotation)"
        },
        {
          "name": "Row4",
          "playBeep": false,
          "onSelected": "actuate(ItemText4);transition(TopLevelRotation)"
        }
      ]
    }
  ]
