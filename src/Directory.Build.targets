<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(OutputType)' == 'Library'">
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <ReferenceAssemblyPath>
      $(OutputPath)$(AssemblyName).ref.dll
    </ReferenceAssemblyPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OutputType)' == 'Exe'">
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <PropertyGroup>
  <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
</PropertyGroup>
  <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm">
      <Version>8.4.0</Version>
    </PackageReference>
  </ItemGroup>

  <Target Name="FilterBrainFlowNativeFiles" AfterTargets="CopyMyPackageFiles">
    <!-- Remove non-Windows files from output -->
    <ItemGroup>
      <FilesToDelete Include="$(OutputPath)**\*.dylib;$(OutputPath)**\*.so" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" />
    <ItemGroup>
      <FilesToDelete Include="$(OutputPath)**\*.dylib;$(OutputPath)**\*.dylib" />
    </ItemGroup>
    <Delete Files="@(FilesToDelete)" />
  </Target>
</Project>
