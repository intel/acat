{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/intel/acat/Config/Schemas/ThemeSettings.schema.json",
  "title": "ACAT Theme Settings",
  "description": "Color schemes and styling configuration for the ACAT user interface",
  "version": "1.0.0",
  "type": "object",
  "required": ["description", "colorSchemes"],
  "properties": {
    "description": {
      "type": "string",
      "description": "Human-readable description of this theme",
      "minLength": 1,
      "examples": ["The default theme with high contrast", "Light theme", "Dark theme"]
    },
    "colorSchemes": {
      "type": "array",
      "description": "List of color schemes for different UI element types",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/colorScheme"
      }
    }
  },
  "definitions": {
    "colorScheme": {
      "type": "object",
      "description": "Color configuration for a specific UI element type",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the color scheme (must match a widget type used in panel configurations)",
          "minLength": 1,
          "examples": [
            "Scanner",
            "ScannerButton",
            "DisabledScannerButton",
            "WordListItemButton",
            "Dialog",
            "Menu",
            "MenuTitle",
            "Button",
            "HighContrast",
            "TalkWindow"
          ]
        },
        "background": {
          "type": "string",
          "description": "Background color in normal state (named color or hex: #RGB or #RRGGBB)",
          "default": "",
          "pattern": "^(#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})|[A-Za-z]+)?$",
          "examples": ["#232433", "White", "Black", "#FFAA00"]
        },
        "foreground": {
          "type": "string",
          "description": "Foreground (text) color in normal state",
          "default": "",
          "pattern": "^(#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})|[A-Za-z]+)?$",
          "examples": ["White", "Black", "#232433"]
        },
        "highlightBackground": {
          "type": "string",
          "description": "Background color when the element is highlighted during scanning",
          "default": "",
          "pattern": "^(#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})|[A-Za-z]+)?$",
          "examples": ["#FFAA00", "Blue", "#FFB100"]
        },
        "highlightForeground": {
          "type": "string",
          "description": "Foreground color when the element is highlighted during scanning",
          "default": "",
          "pattern": "^(#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})|[A-Za-z]+)?$",
          "examples": ["#232433", "White", "Black"]
        },
        "highlightSelectedBackground": {
          "type": "string",
          "description": "Background color when highlighted and selected",
          "default": "",
          "pattern": "^(#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})|[A-Za-z]+)?$",
          "examples": ["Blue", "Black", "Gray"]
        },
        "highlightSelectedForeground": {
          "type": "string",
          "description": "Foreground color when highlighted and selected",
          "default": "",
          "pattern": "^(#([0-9A-Fa-f]{3}|[0-9A-Fa-f]{6})|[A-Za-z]+)?$",
          "examples": ["White", "#FFFFFF", "#FFFF7F"]
        },
        "backgroundImage": {
          "type": "string",
          "description": "Path to a background image file. When specified, the background color is ignored.",
          "default": ""
        },
        "highlightBackgroundImage": {
          "type": "string",
          "description": "Path to a background image file when highlighted. When specified, highlightBackground is ignored.",
          "default": ""
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
