<?xml version="1.0" ?>
<!DOCTYPE ACAT [
]>

<ACAT>
  <WidgetAttributes>
        <WidgetAttribute name="Settings" value="@CmdGoBack" />
        <WidgetAttribute name="Help" value="@CmdTypingModeSentence" />
        <WidgetAttribute name="Phrase" value="@CmdTypingModePhrase" />
        <WidgetAttribute name="Shorthand" value="@CmdTypingModeShortHand" />
  </WidgetAttributes>

  <Layout>
	  <Widget class="BoxWidget"  name="ToolbarUserControl">
		  <Widget class="ScannerButton" name="Settings" />
		  <Widget class="ScannerButton" name="Help" />
		  <Widget class="ScannerButton" name="About" />
		  <Widget class="ScannerButton" name="Home" />
	  </Widget>
  </Layout>

  <Animations>
    <Animation name="TopLevelRotation"
               start="true"
               iterations="@GridScanIterations">
    </Animation>
	<Animation name="KeyboardSequences">
		<Animation name="Column">
			<Widget name="Settings" tagID="1" />
		</Animation>
		<Animation name="Column">
			<Widget name="Help" tagID="2" />
		</Animation>
		<Animation name="Column">
			<Widget name="About" tagID="3" />
		</Animation>
		<Animation name="Column">
			<Widget name="Home" tagID="4" />
		</Animation>
	</Animation>

	  <Animation name="ButtonPressed"
		   onEnter=""
		   iterations="-1"
		   onEnd="transition(TopLevelRotation)">
		  <Widget name="@SelectedWidget" firstPauseTime="@FirstRepeatTime" onSelect="actuate(@SelectedWidget);transition(ButtonPressed)" />
	  </Animation>

    <Animation name="FunctionRotation"
                iterations="@RowScanIterations"
               firstPauseTime="@FirstPauseTime"
               onEnd="transition(TopLevelRotation)">
    </Animation>

    <Animation name="KeyboardRotation"
                iterations="@RowScanIterations"
               firstPauseTime="@FirstPauseTime"
               onEnd="transition(TopLevelRotation)">
    </Animation>

    <Animation name="SpeechRotation"
                iterations="@RowScanIterations"
               firstPauseTime="@FirstPauseTime"
               onEnd="transition(TopLevelRotation)">
    </Animation>
  </Animations>
</ACAT>