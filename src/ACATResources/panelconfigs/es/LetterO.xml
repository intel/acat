<?xml version="1.0" ?>
<!DOCTYPE ACAT [
  <!ENTITY usebold "false">
  <!ENTITY buttonFontName "Arial">
]>

<ACAT>
  <WidgetAttributes>
    <WidgetAttribute name="B1" label="" value="" fontname="&buttonFontName;" fontsize="22" bold="&usebold;" />
    <WidgetAttribute name="B2" label="o" value="o" fontname="&buttonFontName;" fontsize="22" bold="&usebold;" />
    <WidgetAttribute name="B3" label="&#xf3;" value="&#xf3;" shiftValue="&#xd3;" fontname="&buttonFontName;" fontsize="22"  bold="&usebold;" />
    <WidgetAttribute name="B4" label="l" value="@CmdGoBack" fontname="ACAT Icon" fontsize="22" bold="&usebold;" />
  </WidgetAttributes>

  <Layout>
    <Widget class="ScannerButton" name="B1" colorScheme="Menu"  disabledButtonColorScheme="Menu" enabled="false"/>
    <Widget class="ScannerButton" name="B2" colorScheme="Menu"  disabledButtonColorScheme="Menu"/>
    <Widget class="ScannerButton" name="B3" colorScheme="Menu"  disabledButtonColorScheme="Menu"/>
    <Widget class="ScannerButton" name="B4" colorScheme="Menu"  disabledButtonColorScheme="Menu"/>
  </Layout>

  <Animations>
    <Animation name="TopLevelRotation"
                  iterations="@StripScannerColumnIterations"
                  autoStart="true"
                  start="true"
                  firstPauseTime="@FirstPauseTime"
                  onEnd="close()"
                  onSelect="actuate(@SelectedWidget)">
      <Widget name="B1"/>
      <Widget name="B2"/>
      <Widget name="B3"/>
      <Widget name="B4"/>
    </Animation>
  </Animations>
</ACAT>
