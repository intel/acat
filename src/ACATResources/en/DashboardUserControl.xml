<?xml version="1.0" ?>
<!DOCTYPE ACAT [
  <!ENTITY functionButtonFontName "ACAT FONT 1">
  <!ENTITY functionButtonAltFontName "ACAT Icon">
  <!ENTITY functionButtonFontSize "44">

]>

<ACAT>
  <WidgetAttributes>
        <WidgetAttribute name="ACATTalk" value="@CmdShowACATTalk" fontname="&functionButtonAltFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="QuickTalk" value="@CmdShowQuickTalk" fontname="&functionButtonAltFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="PointerControl" value="@CmdShowPointerControl" fontname="&functionButtonAltFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="Keyboard" value="@CmdShowKeyboard" fontname="&functionButtonFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="System" value="@CmdShowSystem" fontname="&functionButtonFontName;" fontsize="&functionButtonFontSize;" bold="false" />
        <WidgetAttribute name="Location" value="@CmdMoveWindow" fontname="&functionButtonFontName;" fontsize="&functionButtonFontSize;" bold="false" />
  </WidgetAttributes>

  <Layout>
    <Widget class="BoxWidget"  name="ToolbarBox">
      <Widget class="RowWidget"  name="ButtonBoxRow">
        <Widget class="ScannerButton" name="ACATTalk" colorScheme="ScannerButton"/>
        <Widget class="ScannerButton" name="QuickTalk" colorScheme="ScannerButton"/>
        <Widget class="ScannerButton" name="PointerControl" colorScheme="ScannerButton"/>
        <Widget class="ScannerButton" name="Keyboard" colorScheme="ScannerButton"/>
        <Widget class="ScannerButton" name="System" colorScheme="ScannerButton"/>
        <Widget class="ScannerButton" name="Location" colorScheme="ScannerButton"/>
      </Widget>
    </Widget>
  </Layout>

  <Animations>
    <Animation name="TopLevelRotation"
                start="true"
                iterations="1">
        <Widget name="ToolbarBox" onSelect="transition(ButtonRotation)" />
    </Animation>
    <Animation name="ButtonRotation"
          iterations="@RowScanIterations"
          firstPauseTime="@FirstPauseTime"
          onSelect="actuate(@SelectedWidget); transition(ButtonPressed)">
      <Widget name="ACATTalk" />
      <Widget name="QuickTalk" />
      <Widget name="PointerControl" />
      <Widget name="Keyboard" />
      <Widget name="System" />
      <Widget name="Location" />
    </Animation>
    <Animation name="ButtonPressed"
           onEnter=""
           iterations="1"
           onEnd="transition(TopLevelRotation)">
            <Widget name="@SelectedWidget" 
                firstPauseTime="@FirstRepeatTime" 
                onSelect="actuate(@SelectedWidget);transition(ButtonPressed)" />
        </Animation>
  </Animations>
</ACAT>