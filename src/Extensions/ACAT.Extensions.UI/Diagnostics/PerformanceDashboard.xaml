    ACAT PERFORMANCE DASHBOARD - USAGE GUIDE
    ═══════════════════════════════════════════════════════════════════════════

    The PerformanceDashboard is a standalone WPF window that shows live memory
    and runtime metrics, baseline regression status, sample history, and lets
    you export data to CSV or JSON.

    ─── QUICK START ────────────────────────────────────────────────────────────

    Minimal usage – open a self-contained dashboard (creates its own collectors):

        var dashboard = new PerformanceDashboard();
        dashboard.Show();

    ─── SHARED COLLECTORS ──────────────────────────────────────────────────────

    To display metrics already gathered by your application, pass the existing
    RuntimeMetricsCollector and MemoryProfiler instances.  The dashboard then
    shows their accumulated data instead of starting fresh:

        // In your application startup:
        var collector = new RuntimeMetricsCollector();
        var profiler  = new MemoryProfiler();
        collector.Start(intervalMs: 5000);
        profiler.CaptureSnapshot("Startup");

        // Later, open the dashboard and share the same instances:
        var dashboard = new PerformanceDashboard(
            collector: collector,
            profiler:  profiler);
        dashboard.Show();

    ─── CUSTOM BASELINE ────────────────────────────────────────────────────────

    Supply a custom PerformanceBaselineData to change the regression thresholds
    shown in the "Baseline Status" panel.  If omitted, the built-in ACAT
    defaults are used (startup < 3 s, input lag < 100 ms, etc.):

        string baselinePath = Path.Combine(
            Environment.GetFolderPath(Environment.SpecialFolder.ApplicationData),
            "ACAT", "performance_baseline.json");

        PerformanceBaselineData baseline = PerformanceBaseline.Load(baselinePath);

        var dashboard = new PerformanceDashboard(
            collector: collector,
            profiler:  profiler,
            baseline:  baseline);
        dashboard.Show();

    ─── EXPORT ─────────────────────────────────────────────────────────────────

    Use the toolbar buttons to export captured data:
      • Export CSV  – all memory snapshots as a comma-separated file
      • Export JSON – memory snapshots + aggregated runtime metric entries

    ─── PANELS ─────────────────────────────────────────────────────────────────

    Memory         Working set, managed heap, and total GC collection count.
    Runtime        Process uptime, active thread count, OS handle count.
    Baseline Status  Green ✓ = all tracked metrics within thresholds;
                     Orange ⚠ = one or more thresholds exceeded.
    Sample History Peak working-set observed across all snapshots and the
                   timestamp of the most recent refresh.

    Metrics refresh automatically every 2 seconds while the window is open.
    ═══════════════════════════════════════════════════════════════════════════
-->
<Window x:Class="ACAT.Extensions.UI.Diagnostics.PerformanceDashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACAT Performance Dashboard"
        Height="520" Width="760"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E2E"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFCDD6F4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFA6E3A1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9399B2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
        </Style>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="#FF313244"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="DashboardButton" TargetType="Button">
            <Setter Property="Background" Value="#FF89B4FA"/>
            <Setter Property="Foreground" Value="#FF1E1E2E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="⚡ ACAT Performance Dashboard"
                       Foreground="#FFCBA6F7" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusIndicator" Text="● Live"
                       Foreground="#FFA6E3A1" FontSize="12"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Metrics grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Memory section -->
            <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Memory" Style="{StaticResource HeaderText}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Working Set" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="WorkingSetValue" Text="-- MB" Style="{StaticResource ValueText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Managed Heap" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ManagedHeapValue" Text="-- MB" Style="{StaticResource ValueText}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="GC Collections" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="GcCollectionsValue" Text="--" Style="{StaticResource ValueText}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Runtime section -->
            <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Runtime" Style="{StaticResource HeaderText}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Uptime" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UptimeValue" Text="-- s" Style="{StaticResource ValueText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Threads" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ThreadCountValue" Text="--" Style="{StaticResource ValueText}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Handles" Style="{StaticResource LabelText}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="HandleCountValue" Text="--" Style="{StaticResource ValueText}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Regression status section -->
            <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Baseline Status" Style="{StaticResource HeaderText}"/>
                    <TextBlock x:Name="RegressionStatus"
                               Text="Checking..."
                               Foreground="#FFFAB387"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Sample history section -->
            <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="Sample History" Style="{StaticResource HeaderText}"/>
                    <TextBlock x:Name="SampleCount" Text="0 samples" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="PeakWorkingSet" Text="Peak WS: -- MB" Style="{StaticResource LabelText}"/>
                    <TextBlock x:Name="LastSampleTime" Text="Last: --" Style="{StaticResource LabelText}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Export/action row -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,8,4,4">
            <Button Content="Export CSV" Style="{StaticResource DashboardButton}"
                    Margin="0,0,8,0" Click="OnExportCsvClick"
                    AutomationProperties.Name="Export performance data as CSV"/>
            <Button Content="Export JSON" Style="{StaticResource DashboardButton}"
                    Margin="0,0,8,0" Click="OnExportJsonClick"
                    AutomationProperties.Name="Export performance data as JSON"/>
            <Button Content="Refresh" Style="{StaticResource DashboardButton}"
                    Margin="0,0,8,0" Click="OnRefreshClick"
                    AutomationProperties.Name="Refresh metrics"/>
            <Button Content="Clear History" Style="{StaticResource DashboardButton}"
                    Background="#FFF38BA8"
                    Click="OnClearHistoryClick"
                    AutomationProperties.Name="Clear sample history"/>
        </StackPanel>

        <!-- Status bar -->
        <TextBlock Grid.Row="3" x:Name="StatusBar"
                   Text="Ready"
                   Foreground="#FF585B70"
                   FontSize="11"
                   Margin="4,0"/>
    </Grid>
</Window>
