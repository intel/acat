<?xml version="1.0" ?>
<!DOCTYPE ACAT [
]>

<ACAT>
  <WidgetAttributes>
    <WidgetAttribute name="Settings" value="@CmdShowSettings" />
    <WidgetAttribute name="Help" value="@CmdShowHelp" />
    <WidgetAttribute name="About" value="@CmdShowAbout" />
    <WidgetAttribute name="PanelSettings" value="@CmdPanelSettings" />
    <WidgetAttribute name="Home" value="@CmdGoHome" />
  </WidgetAttributes>

  <Layout>
    <Widget class="BoxWidget"  name="ToolbarBox">
      <Widget class="RowWidget" name ="ButtonBoxRow">
        <Widget class="ScannerButton" name="Settings" colorScheme="ScannerButton" />
        <Widget class="ScannerButton" name="Help" colorScheme="ScannerButton" />
        <Widget class="ScannerButton" name="About" colorScheme="ScannerButton" />
        <Widget class="ScannerButton" name="PanelSettings" colorScheme="ScannerButton" />
        <Widget class="ScannerButton" name="Home" colorScheme="ScannerButton" />
      </Widget>
    </Widget>
  </Layout>

  <Animations>
    <Animation name="TopLevelRotation"
               start="true"
               onEnter=""
               scanTime="@MenuDialogScanTime"
               iterations="1"
               onSelect="actuate(@SelectedWidget);stop();">
      <Widget name="Settings" />
      <Widget name="Help" />
      <Widget name="About" />
      <Widget name="PanelSettings" />
      <Widget name="Home" />
    </Animation>
  </Animations>
</ACAT>